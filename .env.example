# Frontend OAuth (Angular) — not read automatically at runtime.
# Copy the Auth0 SPA client id into:
#   src/environments/environment.development.ts  (local)
#   src/environments/environment.production.ts   (Render build)
#
# Backend Auth0 verification uses backend/server/.env instead.

# Same tenant as MERN-MultiChat / My Profiling APP
AUTH0_DOMAIN=pwconsulting.auth0.com
AUTH0_CLIENT_ID=

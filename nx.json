{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": []
  },
  "tui": {
    "enabled": false
  },
  "targetDefaults": {
    "serve": {
      "cache": false,
      "continuous": true
    },
    "build": {
      "cache": true
    },
    "test": {
      "cache": true
    }
  },
  "analytics": true
}
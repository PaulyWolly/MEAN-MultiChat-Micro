{
  "name": "mean-multichat-micro",
  "version": "1.0.0",
  "private": true,
  "nx": {
    "includedScripts": []
  },
  "scripts": {
    "ng": "ng",
    "nx": "nx",
    "kill:dev": "node scripts/kill-dev.mjs",
    "install:backend": "node scripts/install-backend.mjs",
    "dev": "npm run kill:dev && cross-env NX_TUI=false nx run mean-multichat-micro:dev-stack --output-style=stream",
    "dev:micro": "npm run kill:dev && cross-env NX_TUI=false nx run-many -t serve --parallel=100 --output-style=stream --projects=gateway,auth,rag,images,chat,media,speech,jokes,recipes,profile,usage,platform,monolith,mean-multichat-micro",
    "dev:client": "nx serve mean-multichat-micro",
    "dev:server": "nx run monolith:serve-dev",
    "start:server": "cross-env PORT=4800 npm --prefix backend/server start",
    "start:gateway": "nx serve gateway",
    "start:auth": "nx serve auth",
    "start:rag": "nx serve rag",
    "start:images": "nx serve images",
    "start:chat": "nx serve chat",
    "start:media": "nx serve media",
    "start:speech": "nx serve speech",
    "start:jokes": "nx serve jokes",
    "start:recipes": "nx serve recipes",
    "start:profile": "nx serve profile",
    "start:usage": "nx serve usage",
    "start:platform": "nx serve platform",
    "start:monolith": "nx serve monolith",
    "start": "nx serve mean-multichat-micro",
    "build": "nx build mean-multichat-micro",
    "docker:api:build": "docker build -t mean-multichat-api -f backend/Dockerfile backend",
    "watch": "ng build --watch --configuration development",
    "test": "nx test mean-multichat-micro"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^20.2.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "bootstrap": "^5.3.8",
    "cross-env": "^7.0.3",
    "marked": "^15.0.12",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.34",
    "@angular/cli": "^20.3.34",
    "@angular/compiler-cli": "^20.3.0",
    "@nx/workspace": "23.2.1",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nx": "23.2.1",
    "typescript": "~5.9.2"
  }
}

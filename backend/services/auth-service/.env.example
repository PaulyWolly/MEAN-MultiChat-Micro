# Copy to .env for local overrides. Secrets stay in backend/server/.env
# (server.js loads that file first, then this one with override: true).
PORT=4801
CORS_ORIGIN=http://localhost:4200
# Optional overrides only if you must not share the monolith .env:
# MONGODB_URI=
# JWT_SECRET=
# SUPERADMIN_PASSWORD=
# CLI_SECRET=
# AUTH0_ISSUER_BASE_URL=

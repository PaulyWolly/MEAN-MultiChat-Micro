# Copy to .env for local overrides. Secrets stay in backend/server/.env
# (server.js loads that file first, then this one).
PORT=4804
CORS_ORIGIN=http://localhost:4200
# Optional overrides only if you must not share the monolith .env:
# MONGODB_URI=
# JWT_SECRET=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

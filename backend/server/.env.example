# Template only — no secrets. This is the only env file committed to git.
#
# Local dev: copy to backend/server/.env and fill in values (.env is gitignored).
# Render: add the same keys in the service Environment tab — do not upload .env.

PORT=4810
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=

# AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_RAG_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Image generation presets (Images page)
OPENAI_IMAGE_MODEL_CHEAP=gpt-image-1-mini
OPENAI_IMAGE_MODEL_QUALITY=gpt-image-2

# Google / YouTube (YouTube Data API only)
GOOGLE_API_KEY=

# Image search needs no key: Openverse is the primary source and Wikimedia
# Commons the fallback.

# Azure speech (Conversation Mode TTS)
SPEECH_API_KEY=
SPEECH_REGION=

# Auth
JWT_SECRET=
SUPERADMIN_PASSWORD=
CLI_SECRET=

# Auth0 social login (optional)
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_DOMAIN=

# Extra allowed browser origins, comma-separated (localhost is always allowed).
# On Render, set to your deployed frontend URL.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# AI guard rails
# Every value below is optional; the defaults shown are what the server uses if
# the variable is unset. GET /api/ai/status publishes these to the UI, so the
# limits users are shown always match the limits that are enforced.
# ---------------------------------------------------------------------------

# Chat / TTS input ceilings (characters)
AI_CHAT_MAX_CHARS=8000
AI_TTS_MAX_CHARS=5000

# Image generation. AI_IMAGE_DAILY_LIMIT is per signed-in user per UTC day;
# set it to 0 to switch generation off without redeploying. Kept low on purpose
# — this is the only feature that bills per call.
AI_IMAGE_DAILY_LIMIT=5
AI_IMAGE_MAX_PROMPT_CHARS=4000
AI_IMAGE_MAX_UPLOAD_MB=10

# RAG document library
AI_RAG_MAX_DOCS=20
AI_RAG_MAX_UPLOAD_MB=50
AI_RAG_MAX_QUESTION_CHARS=2000
